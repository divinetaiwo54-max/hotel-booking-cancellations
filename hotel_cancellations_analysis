        "print(f\"Revenue from stays: €{kept:,.0f}\")\n",
        "print(f\"Revenue lost to cancellations: €{lost:,.0f} ({lost/(lost+kept)*100:.1f}%)\")\n",
        "print(f\"Lost excluding non-refundable: €{lost_real:,.0f}\")\n",
        "\n",
        "monthly = df.set_index(\"arrival_date\").resample(\"MS\").agg(\n",
        "    bookings=(\"is_canceled\", \"count\"), cancel_rate=(\"is_canceled\", \"mean\"))\n",
        "monthly[\"cancel_rate\"] *= 100\n",
        "fig, ax1 = plt.subplots(figsize=(10, 4))\n",
        "ax1.bar(monthly.index, monthly[\"bookings\"], width=20, color=\"#B7C9D6\")\n",
        "ax1.set_ylabel(\"Bookings\")\n",
        "ax2 = ax1.twinx()\n",
        "ax2.plot(monthly.index, monthly[\"cancel_rate\"], color=\"#C0392B\", marker=\"o\")\n",
        "ax2.set_ylabel(\"Cancelled (%)\")\n",
        "plt.title(\"Monthly bookings and cancellation rate\"); plt.tight_layout(); plt.show()"
